# Local secrets
/wp-config.php
/wp-config-local.php
/.env
/.env.*
/public/.env
/public/.env.*
!.env.example
!/public/.env.example

# WordPress core, user uploads, backups, caches, logs, and temporary files
/wp-admin/
/wp-includes/
/wp-content/uploads/
/wp-content/wpvividbackups/
/wp-content/wflogs/
/wp-content/cache/
/wp-content/upgrade/
/wp-content/ai1wm-backups/
/wp-content/backups/
/wp-content/debug.log
*.sql
*.zip
*.tar
*.tar.gz
*.tgz
*.log
*.md

# Next.js dependencies and generated output
/public/node_modules/
/public/.next/
/public/out/
/public/_next/
/public/*.html
/public/*.txt
/public/.vercel/
/public/.snowflake/
/public/.v0-trash/
/public/.env*.local
/live-build/

# Deployee runtime settings and generated database backups
/deployee/storage/*
!/deployee/storage/.gitignore
!/deployee/storage/.htaccess

# OS/editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
